<mxfile host="app.diagrams.net" agent="draft" version="24.0.0">
  <diagram name="MVP Pipeline" id="mvp-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Voice-Driven Transfer Function Design — Local MVP" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Solid = built now, runs locally. Dashed = later stages, interfaces prepared." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="46" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;speaks, judges&lt;br&gt;better / worse&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="asr" value="&lt;b&gt;Whisper (ASR)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;faster-whisper, local CPU&lt;br&gt;push-to-talk&lt;br&gt;WAV + transcript logged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="240" y="130" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="parser" value="&lt;b&gt;Rule-based Parser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;text → command dict&lt;br&gt;{target, attribute,&lt;br&gt;direction, strength}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="460" y="130" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="lookup" value="&lt;b&gt;Tissue Lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Hounsfield ranges&lt;br&gt;air / fat / soft /&lt;br&gt;spongy / bone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="680" y="130" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="apply" value="&lt;b&gt;apply_command&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;fixed heuristic&lt;br&gt;picks nearest peak,&lt;br&gt;scales its height&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="670" y="290" width="180" height="85" as="geometry" />
        </mxCell>

        <mxCell id="tf" value="&lt;b&gt;Transfer Function&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;4 Gaussian peaks = 24 values&lt;br&gt;normalised to [-1, 1]&lt;br&gt;→ vtkColorTransferFunction&lt;br&gt;→ vtkPiecewiseFunction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="290" width="190" height="85" as="geometry" />
        </mxCell>

        <mxCell id="vtk" value="&lt;b&gt;VTK render&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;offscreen, fixed camera&lt;br&gt;CT phantom in HU&lt;br&gt;GPU raycast, CPU fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="290" width="180" height="85" as="geometry" />
        </mxCell>

        <mxCell id="feat" value="&lt;b&gt;Image Features&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;mean, std, coverage, entropy&lt;br&gt;+ PNG per step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="450" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="eval" value="&lt;b&gt;evaluate → +1 / −1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;objective: opacity_mass&lt;br&gt;in target HU range&lt;br&gt;human: b / s on console&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="430" y="450" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="climb" value="&lt;b&gt;Hill-Climbing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;+1 → keep direction, step × 1.2&lt;br&gt;−1 → revert, halve step&lt;br&gt;no torch, no replay buffer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="670" y="450" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="log" value="&lt;b&gt;JSONL log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;command, params before/after,&lt;br&gt;features, verdict, timestamp&lt;br&gt;&lt;i&gt;→ training data for later&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="430" y="600" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="llm_later" value="&lt;b&gt;LLM Parser (Ollama)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;--parser llm, default: rule&lt;br&gt;qwen2.5:7b, JSON schema&lt;br&gt;validated, no numeric values,&lt;br&gt;falls back to rule parser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="900" y="122" width="180" height="96" as="geometry" />
        </mxCell>

        <mxCell id="sac_later" value="&lt;b&gt;SAC Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;continuous deltas,&lt;br&gt;goal-conditioned,&lt;br&gt;replay buffer + HER&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;dashed=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="900" y="290" width="160" height="85" as="geometry" />
        </mxCell>

        <mxCell id="vr_later" value="&lt;b&gt;VTK-VRUI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;stereo output, HMD&lt;br&gt;TF overlay on histogram&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;dashed=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="50" y="290" width="130" height="85" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="speaks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="user" target="asr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="asr" target="parser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="target name" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="parser" target="lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="command + HU range" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lookup" target="apply">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="new parameter vector" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="apply" target="tf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="color + opacity curve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="tf" target="vtk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="vtk" target="feat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="before / after" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="feat" target="eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="eval" target="climb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="next step&#10;(loop)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="climb" target="apply">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="760" y="410" /><mxPoint x="890" y="410" /><mxPoint x="890" y="333" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a11" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="eval" target="log">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="better / worse&#10;(human evaluator)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.84;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="eval">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="190" y="210" /><mxPoint x="190" y="560" /><mxPoint x="590" y="560" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="r1" value="--parser rule|llm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#9673a6;fontColor=#666666;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="parser" target="llm_later">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="545" y="95" /><mxPoint x="990" y="95" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r1b" value="target name" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#9673a6;fontColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="llm_later" target="lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="later replaces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apply" target="sac_later">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="later adds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vtk" target="vr_later">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a13" value="human judgment&#10;(objective verdict for the&#10;same step logged too)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eval" target="prefs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="380" y="490" /><mxPoint x="380" y="850" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a14" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#b85450;" edge="1" parent="1" source="prefs" target="statsbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Purple: speech path — once per utterance&lt;br&gt;Yellow: deterministic lookup, no learning&lt;br&gt;Green: parameter determination — per step&lt;br&gt;Blue: rendering&lt;br&gt;Orange: evaluation signal&lt;br&gt;Red: persisted data&lt;br&gt;Grey dashed: not built yet&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=none;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="290" height="140" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Scope note&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;The MVP has no RL yet — hill-climbing on a binary&lt;br&gt;verdict. That is the &lt;i&gt;baseline&lt;/i&gt; the learned agent&lt;br&gt;must beat, and the JSONL logs are what train it.&lt;br&gt;&lt;br&gt;No MLLM judge, no neural reward model:&lt;br&gt;opacity_mass over Hounsfield ranges is already an&lt;br&gt;exact, free reward for any nameable target tissue.&lt;br&gt;Human and objective verdicts are &lt;i&gt;both&lt;/i&gt; logged on&lt;br&gt;every human-judged step, whichever one drives&lt;br&gt;that run's hill-climbing — so agreement between&lt;br&gt;them can be measured later without re-running.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="670" y="600" width="330" height="180" as="geometry" />
        </mxCell>

        <mxCell id="prefs" value="&lt;b&gt;preferences.jsonl&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;before/after PNGs, cmd text + dict,&lt;br&gt;both param vectors + feature dicts,&lt;br&gt;human verdict &amp;amp; objective verdict&lt;br&gt;(both always logged), session id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="50" y="810" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="statsbox" value="&lt;b&gt;stats.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;pairs per target tissue&lt;br&gt;agreement rate, overall + per tissue&lt;br&gt;disagreement cases w/ PNG paths&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="345" y="810" width="200" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
