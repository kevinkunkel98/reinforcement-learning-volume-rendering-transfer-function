          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="color + opacity curve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="tf" target="vtk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="vtk" target="feat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="before / after" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="feat" target="eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="eval" target="climb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="next step&#10;(loop)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="climb" target="apply">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="760" y="410" /><mxPoint x="890" y="410" /><mxPoint x="890" y="333" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a11" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="eval" target="log">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="better / worse&#10;(human evaluator)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#d79b00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.84;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="eval">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="190" y="210" /><mxPoint x="190" y="560" /><mxPoint x="590" y="560" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="r1" value="--parser rule|llm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#9673a6;fontColor=#666666;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="parser" target="llm_later">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="545" y="95" /><mxPoint x="990" y="95" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r1b" value="target name" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#9673a6;fontColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="llm_later" target="lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="reuses peak-resolution logic&#10;(_find_or_create_peak, propose_step)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="apply" target="rl_env">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rl1" value="observation + reward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#3fb6ac;" edge="1" parent="1" source="rl_env" target="rl_train">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rl2" value="trained model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#3fb6ac;" edge="1" parent="1" source="rl_train" target="rl_eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rl3" value="same acceptance rule&#10;(evaluate.objective), for comparison" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="climb" target="rl_eval">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rl4" value="future: wire trained policy&#10;into live loop if it wins" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="rl_eval" target="apply">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="860" y="565" /><mxPoint x="860" y="360" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="r4" value="later adds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;strokeColor=#999999;fontColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vtk" target="vr_later">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a13" value="human judgment&#10;(objective verdict for the&#10;same step logged too)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eval" target="prefs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="380" y="490" /><mxPoint x="380" y="850" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a14" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#b85450;" edge="1" parent="1" source="prefs" target="statsbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Purple: speech path — once per utterance&lt;br&gt;Yellow: deterministic lookup, no learning&lt;br&gt;Green: parameter determination — per step&lt;br&gt;Blue: rendering&lt;br&gt;Orange: evaluation signal&lt;br&gt;Red: persisted data&lt;br&gt;Teal: RL pipeline — built, runs offline&lt;br&gt;Grey dashed: not built yet / not wired in&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=none;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="290" height="150" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;RL status&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;SAC (stable-baselines3) is now trained offline&lt;br&gt;against the same opacity_mass-derived reward&lt;br&gt;(mass_fraction) — no MLLM judge, no neural&lt;br&gt;reward model, same principle as the objective&lt;br&gt;evaluator above.&lt;br&gt;&lt;br&gt;Evaluated against hill-climbing on 20 held-out&lt;br&gt;episodes: near-parity on final quality (0.344 vs&lt;br&gt;0.347 mass fraction), slightly slower convergence&lt;br&gt;(3.3 vs 2.7 steps to 90%). A well-tuned heuristic&lt;br&gt;is a strong baseline on this low-dimensional&lt;br&gt;control problem.&lt;br&gt;&lt;br&gt;Not yet wired into the live command loop —&lt;br&gt;server.py still runs on rule/LLM parsing +&lt;br&gt;hill-climbing.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="670" y="600" width="330" height="230" as="geometry" />
        </mxCell>

        <mxCell id="prefs" value="&lt;b&gt;preferences.jsonl&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;before/after PNGs, cmd text + dict,&lt;br&gt;both param vectors + feature dicts,&lt;br&gt;human verdict &amp;amp; objective verdict&lt;br&gt;(both always logged), session id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="50" y="810" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="statsbox" value="&lt;b&gt;stats.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;pairs per target tissue&lt;br&gt;agreement rate, overall + per tissue&lt;br&gt;disagreement cases w/ PNG paths&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="345" y="810" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cam_cmd" value="&lt;b&gt;Camera Command&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;from same parser (rule/LLM)&lt;br&gt;{action, direction, strength}&lt;br&gt;rotate / tilt / zoom&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="130" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cam_state" value="&lt;b&gt;Camera State&lt;/b&gt; (camera.py)&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;DEFAULT_CAMERA: azimuth /&lt;br&gt;elevation / zoom&lt;br&gt;azimuth wraps mod 360°,&lt;br&gt;elevation &amp;amp; zoom clamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1180" y="250" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="rl_cam_env" value="&lt;b&gt;CameraViewpointEnv&lt;/b&gt; (rl/camera_env.py)&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Gymnasium env on real CT volume&lt;br&gt;obs: sin/cos azimuth + elevation&lt;br&gt;+ tissue one-hot + alignment&lt;br&gt;action: Δazimuth, Δelevation&lt;br&gt;reward: Δalignment to tissue centroid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ec;strokeColor=#3fb6ac;fontColor=#04211e;" vertex="1" parent="1">
          <mxGeometry x="1180" y="390" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="rl_cam_train" value="&lt;b&gt;SAC Training&lt;/b&gt; (rl/camera_train.py)&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;stable-baselines3, MlpPolicy&lt;br&gt;200k timesteps, ct_skull dataset&lt;br&gt;→ out/rl_models/sac_camera_agent.zip&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ec;strokeColor=#3fb6ac;fontColor=#04211e;" vertex="1" parent="1">
          <mxGeometry x="1180" y="520" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="rl_cam_eval" value="&lt;b&gt;Evaluation&lt;/b&gt; (rl/camera_eval.py)&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;policy vs. 2D hill-climb baseline,&lt;br&gt;same held-out episodes&lt;br&gt;&lt;b&gt;0.997 vs 1.000&lt;/b&gt; mean alignment&lt;br&gt;&lt;b&gt;3.05 vs 4.05&lt;/b&gt; steps to 90%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ec;strokeColor=#3fb6ac;fontColor=#04211e;" vertex="1" parent="1">
          <mxGeometry x="1180" y="630" width="230" height="110" as="geometry" />
        </mxCell>

        <mxCell id="note_cam" value="&lt;b&gt;Camera-viewpoint RL status&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Reward = per-step increase in alignment&lt;br&gt;(dot product of view direction and a&lt;br&gt;target tissue's centroid direction) —&lt;br&gt;a directional proxy, &lt;b&gt;no occlusion&lt;/b&gt;&lt;br&gt;model. Angle-only (no zoom control).&lt;br&gt;&lt;br&gt;Both policy and hill-climb baseline&lt;br&gt;reach near-perfect alignment; the&lt;br&gt;policy converges ~1 step faster on&lt;br&gt;average.&lt;br&gt;&lt;br&gt;Not yet wired into the live camera&lt;br&gt;loop — server.py still applies camera&lt;br&gt;commands directly via camera.py.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1180" y="760" width="330" height="230" as="geometry" />
